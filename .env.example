# Every environment variable the service reads. Copy to .env (never commit .env or a key).
# --- LLM: any OpenAI-compatible chat-completions endpoint with tool calling ---
LLM_API_KEY=
# Groq free tier (default):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Gemini free tier:    LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-2.0-flash
# Anthropic:           LLM_BASE_URL=https://api.anthropic.com/v1/                              LLM_MODEL=claude-sonnet-5-5
# CI / plumbing tests only, no key needed (rule-based stand-in for the model, NOT the real agent):
# LLM_BACKEND=mock
# --- set by docker-compose, override only when running outside it ---
# DATABASE_URL=postgresql://qd:qd@db:5432/qd
# PAYSWIFT_BASE_URL=http://payswift:8081
# DATA_DIR=/app/data
# LLM_TIMEOUT=12      seconds per model call
# AGENT_BUDGET=40     soft cap per message (vendor retries are safe: deduped by message_id)
